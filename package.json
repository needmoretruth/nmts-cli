{
  "name": "@needmoretruth/nmts-cli",
  "version": "0.26.0",
  "description": "Command-line and MCP access to NMTS: open-source, end-to-end encrypted storage on the Walrus network. No fee to NMTS; you pay the network from your own wallet. For people and for their agents.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/needmoretruth/nmts-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needmoretruth/nmts-cli.git"
  },
  "bugs": {
    "url": "https://github.com/needmoretruth/nmts-cli/issues"
  },
  "keywords": [
    "nmts",
    "walrus",
    "sui",
    "encryption",
    "e2ee",
    "storage",
    "cli",
    "mcp",
    "agent"
  ],
  "type": "module",
  "bin": {
    "nmts": "./dist/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest-write": {
      "types": "./dist/manifest-write.d.ts",
      "default": "./dist/manifest-write.js"
    },
    "./drive-paths": {
      "types": "./dist/drive-paths.d.ts",
      "default": "./dist/drive-paths.js"
    },
    "./upload-file": {
      "types": "./dist/upload-file.d.ts",
      "default": "./dist/upload-file.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "default": "./dist/download.js"
    },
    "./wallet-sign": {
      "types": "./dist/wallet-sign.d.ts",
      "default": "./dist/wallet-sign.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "AGENTS.md",
    "docs",
    "LICENSE",
    "LICENSING.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mysten/sui": "^2.20.1",
    "@mysten/walrus": "^1.2.3",
    "uqr": "^0.1.3"
  }
}
