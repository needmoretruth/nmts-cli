{
  "name": "@needmoretruth/nmts-cli",
  "version": "0.39.0",
  "description": "Command-line and MCP access to NMTS (NeedMoreTruthStorage, https://nmts.me): open-source, end-to-end encrypted storage on the Walrus network. No fee to NMTS; you pay the network from your own wallet. For people and for their agents.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nmts.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needmoretruth/nmts-cli.git"
  },
  "bugs": {
    "url": "https://github.com/needmoretruth/nmts-cli/issues"
  },
  "keywords": [
    "nmts",
    "walrus",
    "sui",
    "encryption",
    "e2ee",
    "end-to-end-encryption",
    "encrypted-storage",
    "storage",
    "cloud-storage",
    "non-custodial",
    "cli",
    "mcp",
    "mcp-server",
    "agent",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "nmts": "./dist/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "default": "./dist/portable.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest-write": {
      "types": "./dist/manifest-write.d.ts",
      "default": "./dist/manifest-write.js"
    },
    "./drive-paths": {
      "types": "./dist/drive-paths.d.ts",
      "default": "./dist/drive-paths.js"
    },
    "./drive-edit": {
      "types": "./dist/drive-edit.d.ts",
      "default": "./dist/drive-edit.js"
    },
    "./drive-erase": {
      "types": "./dist/drive-erase.d.ts",
      "default": "./dist/drive-erase.js"
    },
    "./s3-gateway": {
      "types": "./dist/s3-gateway.d.ts",
      "default": "./dist/s3-gateway.js"
    },
    "./upload-file": {
      "types": "./dist/upload-file.d.ts",
      "default": "./dist/upload-file.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "default": "./dist/download.js"
    },
    "./wallet-sign": {
      "types": "./dist/wallet-sign.d.ts",
      "default": "./dist/wallet-sign.js"
    },
    "./vendor/nmts-crypto/*": "./vendor/nmts-crypto/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "AGENTS.md",
    "docs",
    "LICENSE",
    "LICENSING.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/host.ts --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mysten/sui": "^2.20.1",
    "@mysten/walrus": "^1.2.3",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "uqr": "^0.1.3"
  },
  "mcpName": "io.github.needmoretruth/nmts"
}
